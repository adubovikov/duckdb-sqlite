# name: test/sql/storage/attach_options.test
# description:
# group: [sqlite_storage]

require sqlite_scanner

statement error
ATTACH ':memory:' AS mem (TYPE SQLITE, BUSY_TIMEOUT 'hello')
----
Could not convert string

statement error
ATTACH ':memory:' AS mem (TYPE SQLITE, BUSY_TIMEOUT 99999999999)
----
busy_timeout out of range

statement ok
ATTACH ':memory:' AS mem (TYPE SQLITE, BUSY_TIMEOUT 0)

statement ok
DETACH mem

statement ok
ATTACH ':memory:' AS mem (TYPE SQLITE, JOURNAL_MODE 'WAL')

statement ok
DETACH mem

# journal_mode is validated against SQLite's keyword list; anything else (including a second
# statement smuggled in behind the keyword) is rejected before it reaches the PRAGMA
statement error
ATTACH ':memory:' AS mem (TYPE SQLITE, JOURNAL_MODE 'WAL; PRAGMA synchronous=OFF')
----
Invalid value "WAL; PRAGMA synchronous=OFF" for SQLite option journal_mode

statement error
ATTACH ':memory:' AS mem (TYPE SQLITE, JOURNAL_MODE 'bogus')
----
Invalid value "bogus" for SQLite option journal_mode

# synchronous accepts the SQLite keywords (any case) and their numeric spellings
statement ok
ATTACH ':memory:' AS mem (TYPE SQLITE, SYNCHRONOUS 'normal')

statement ok
DETACH mem

statement ok
ATTACH ':memory:' AS mem (TYPE SQLITE, SYNCHRONOUS 1)

statement ok
DETACH mem

statement error
ATTACH ':memory:' AS mem (TYPE SQLITE, SYNCHRONOUS 'sometimes')
----
Invalid value "sometimes" for SQLite option synchronous

statement error
ATTACH ':memory:' AS mem (TYPE SQLITE, SYNCHRONOUS 7)
----
Invalid value "7" for SQLite option synchronous

# wal_autocheckpoint: pages >= 0 (0 = no automatic checkpoint), applied to every handle
statement ok
ATTACH '__TEST_DIR__/wal_autockpt.db' AS ac (TYPE SQLITE, JOURNAL_MODE 'WAL', WAL_AUTOCHECKPOINT 0)

statement ok
CREATE TABLE ac.t AS SELECT range AS i, repeat('x', 1000) AS v FROM range(20000)

query I
SELECT count(*) FROM ac.t
----
20000

statement ok
DETACH ac

statement ok
ATTACH '__TEST_DIR__/wal_autockpt.db' AS ac (TYPE SQLITE, WAL_AUTOCHECKPOINT 4000)

statement ok
DETACH ac

statement error
ATTACH ':memory:' AS mem (TYPE SQLITE, WAL_AUTOCHECKPOINT -1)
----
Invalid value "-1" for SQLite option wal_autocheckpoint

statement error
ATTACH ':memory:' AS mem (TYPE SQLITE, WAL_AUTOCHECKPOINT 'often')
----
Could not convert
